{
  "name": "ai-ascendancy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node.exe --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src/**/*.ts src/**/*.vue tests/**/*.ts *.ts"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  },
  "allowScripts": {
    "esbuild": false
  }
}
